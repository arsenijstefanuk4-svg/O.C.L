    <header>
        <div class="status-container">
            <div class="status-badge">
                <div id="radarDot" class="radar-dot"></div>
                <span id="radarText" style="font-weight:800; font-size:0.8rem; text-transform:uppercase;">Проверка арены...</span>
            </div>
        </div>

        <!-- Реклама/Ссылки на сообщество -->
        <div class="ocl-social-banner">
            <a href="https://t.me/OCLleague" target="_blank" class="ocl-btn">📢 Telegram Канал O.C.L</a>
            <a href="https://t.me/OCLleagechat" target="_blank" class="ocl-btn">💬 Telegram Чат Лиги</a>
        </div>

        <div style="margin-top:15px;">
            <div class="main-badge">Ouroboros Community League</div>
            <h1>Правила боёв <span>O.C.L</span></h1>
        </div>

        <div class="search-wrapper">
            <input type="text" id="searchInput" class="search-input" placeholder="⚡ Поиск правил (пассив, багоюз, слоуклики, демпси...)" oninput="searchRules()">
        </div>

        <div class="nav-scroller">
            <a href="#pd" class="nav-link">1. Пассив</a>
            <a href="#bugs" class="nav-link">2. Багоюз</a>
